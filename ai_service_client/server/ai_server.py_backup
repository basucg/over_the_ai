#!/usr/bin/env python3
"""
AI Diagnostic Server (Linux / Docker)
Listens for SWUpdate notifications streamed over TCP from Android ai_service_client,
tracks update session state, and invokes an SLM (via Ollama or OpenAI-compatible API)
to diagnose root cause when update failures occur using logs from da3_app_fcswupdate,
update_engine_client, and update_engine.
"""

import asyncio
import base64
from dataclasses import dataclass
import io
import json
import logging
import os
import socket
from urllib.parse import urlparse
import sys
import tarfile
import time
from typing import Dict, List, Any, Optional
try:
    import httpx
except ImportError:
    httpx = None

REPORT_SEPARATOR = "=" * 70
PROCESS_LOG_HEADER = "\nPROCESS LOG EXCERPTS:\n"
NO_PROCESS_LOGS_TEXT = "\nPROCESS LOGS: (No log archive received yet)\n"
ARCHIVE_EVENT_NAME = "swUpdateDiagnosticArchive"
ERROR_EVENT_NAMES = {"onUpdateError", "onUpdateState"}


@dataclass(frozen=True)
class ServerConfig:
    tcp_host: str
    tcp_port: int
    slm_api_url: str
    slm_model: str
    slm_timeout_sec: float
    slm_history_events: int
    slm_log_lines: int
    slm_log_chars: int
    diagnostic_dir: str
    reports_dir: str


def load_server_config() -> ServerConfig:
    return ServerConfig(
        tcp_host=os.getenv("AI_SERVER_HOST", "0.0.0.0"),
        tcp_port=int(os.getenv("AI_SERVER_PORT", "9000")),
        slm_api_url=os.getenv("SLM_API_URL", "http://localhost:11434/api/generate"),
        slm_model=os.getenv("SLM_MODEL", "gemma3:4b"),
        slm_timeout_sec=float(os.getenv("SLM_TIMEOUT_SEC", "180")),
        slm_history_events=int(os.getenv("SLM_HISTORY_EVENTS", "3")),
        slm_log_lines=int(os.getenv("SLM_LOG_LINES", "25")),
        slm_log_chars=int(os.getenv("SLM_LOG_CHARS", "800")),
        diagnostic_dir=os.getenv("DIAGNOSTIC_DIR", "/tmp/ai-swupdate-diagnostics"),
        reports_dir=os.getenv("REPORTS_DIR", "/tmp/ai-swupdate-reports"),
    )


CONFIG = load_server_config()

logging.basicConfig(
    level=logging.INFO,
    format="[%(asctime)s] [%(levelname)s] %(message)s",
    datefmt="%H:%M:%S"
)
logger = logging.getLogger("AIServer")

# In-memory history for active update session
session_events: List[Dict[str, Any]] = []




def should_bypass_proxy(url: str) -> bool:
    hostname = (urlparse(url).hostname or "").lower()
    return hostname in {"ollama", "localhost", "127.0.0.1", "host.docker.internal"}


def build_slm_api_candidates(primary_url: str) -> List[str]:
    parsed_url = urlparse(primary_url)
    path = parsed_url.path or "/api/generate"
    port = parsed_url.port or 11434

    candidate_hosts = [parsed_url.hostname or "localhost"]
    for fallback_host in ("ollama", "host.docker.internal", "127.0.0.1", "localhost"):
        if fallback_host not in candidate_hosts:
            candidate_hosts.append(fallback_host)

    scheme = parsed_url.scheme or "http"
    return [f"{scheme}://{host}:{port}{path}" for host in candidate_hosts]


def probe_tcp_endpoint(url: str) -> None:
    parsed_url = urlparse(url)
    hostname = parsed_url.hostname or "localhost"
    port = parsed_url.port or 11434

    try:
        resolved = socket.getaddrinfo(hostname, port, type=socket.SOCK_STREAM)
        resolved_hosts = sorted({entry[4][0] for entry in resolved})
        logger.info("Resolved SLM host %s:%s to %s", hostname, port, ", ".join(resolved_hosts))
    except OSError as error:
        logger.warning("Failed to resolve SLM host %s:%s: %s: %r", hostname, port, type(error).__name__, error)
        return

    last_error = None
    for entry in resolved:
        family, socktype, proto, _, sockaddr = entry
        tcp_socket = socket.socket(family, socktype, proto)
        tcp_socket.settimeout(3.0)
        try:
            tcp_socket.connect(sockaddr)
            logger.info("TCP connect to SLM endpoint succeeded: %s", sockaddr)
            return
        except OSError as error:
            last_error = error
        finally:
            tcp_socket.close()

    logger.warning("TCP connect to SLM endpoint failed for %s:%s: %s: %r", hostname, port, type(last_error).__name__, last_error)


async def post_with_httpx(client: Any, url: str, payload: Dict[str, Any]) -> str:
    payload_bytes = json.dumps(payload).encode("utf-8")
    logger.info("Starting httpx POST to %s with payload_bytes=%d", url, len(payload_bytes))
    response = await client.post(url, content=payload_bytes, headers={"Content-Type": "application/json"})
    logger.info("Completed httpx POST to %s with status_code=%s", url, response.status_code)
    if response.status_code == 200:
        result = response.json()
        return result.get("response", "No response generated by SLM.")
    return f"SLM API Error {response.status_code}: {response.text}"


def post_with_urllib(url: str, payload: Dict[str, Any]) -> str:
    import urllib.request

    data_bytes = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data_bytes, headers={"Content-Type": "application/json"})
    if should_bypass_proxy(url):
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        response = opener.open(req, timeout=CONFIG.slm_timeout_sec)
    else:
        response = urllib.request.urlopen(req, timeout=CONFIG.slm_timeout_sec)

    with response as resp:
        if resp.status == 200:
            res_data = json.loads(resp.read().decode("utf-8"))
            return res_data.get("response", "No response generated by SLM.")
        return f"SLM API Error {resp.status}"


def trim_text(text: str, max_chars: int) -> str:
    if len(text) <= max_chars:
        return text
    return text[:max_chars] + "\n...(truncated)"


def summarize_event(event: Dict[str, Any]) -> Dict[str, Any]:
    keys_to_keep = (
        "event",
        "timestamp",
        "errorCode",
        "errorName",
        "state",
        "stateName",
        "moduleName",
        "subModuleName",
        "releasePercentComplete",
        "subModulePercentComplete",
        "estimatedUpdateTimeSec",
        "line1",
        "line2",
    )
    return {key: event[key] for key in keys_to_keep if key in event}


def build_log_section(process_logs: Optional[Dict[str, str]]) -> str:
    if not process_logs:
        return NO_PROCESS_LOGS_TEXT

    log_sections = [PROCESS_LOG_HEADER]
    for log_file, log_text in process_logs.items():
        log_sections.append(f"\n--- [{log_file}] ---\n{log_text}\n")
    return "".join(log_sections)


def build_diagnostic_prompt(
    error_event: Dict[str, Any],
    recent_history: List[Dict[str, Any]],
    process_logs: Optional[Dict[str, str]],
) -> str:
    summarized_history = [summarize_event(event) for event in recent_history[-CONFIG.slm_history_events:]]
    summarized_error_event = summarize_event(error_event)
    log_section = build_log_section(process_logs)

    return f"""
You diagnose automotive software update failures on IVI and Android platforms.

FAILURE EVENT:
{json.dumps(summarized_error_event, indent=2)}

RECENT HISTORY:
{json.dumps(summarized_history, indent=2)}
{log_section}
Return 5 short sections:
1. Root Cause
2. Evidence
3. Failure Category
4. Recovery Actions
5. Preventive Fix
"""


def print_report(title: str, report_text: str, report_path: str, path_label: str = "Report File Created") -> None:
    print("\n" + REPORT_SEPARATOR)
    print(title)
    print(REPORT_SEPARATOR)
    print(report_text)
    print(REPORT_SEPARATOR)
    if report_path:
        print(f"{path_label}: {report_path}")
    print(REPORT_SEPARATOR + "\n")


def find_latest_diagnostic_event(events: List[Dict[str, Any]], fallback_event: Dict[str, Any]) -> Dict[str, Any]:
    for recorded_event in reversed(events):
        if recorded_event.get("event") in ERROR_EVENT_NAMES:
            return recorded_event
    return fallback_event


async def generate_diagnostic_report(
    trigger_event: Dict[str, Any],
    process_logs: Optional[Dict[str, str]] = None,
    title: str = "                SLM AUTOMATED ROOT CAUSE DIAGNOSIS",
    path_label: str = "Report File Created",
) -> None:
    report_text = await query_slm(trigger_event, session_events, process_logs=process_logs)
    report_timestamp = str(int(time.time()))
    report_path = save_report_file(report_text, report_timestamp)
    print_report(title, report_text, report_path, path_label)


def extract_logs_from_archive(archive_bytes: bytes, max_lines_per_log: int = CONFIG.slm_log_lines) -> Dict[str, str]:
    """Extract log files for da3_app_fcswupdate, update_engine_client, and update_engine from .tar.gz archive."""
    extracted_logs: Dict[str, str] = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode="r:gz") as tar:
            for member in tar.getmembers():
                if member.isfile() and member.name.endswith(".log"):
                    f = tar.extractfile(member)
                    if f:
                        lines = f.read().decode("utf-8", errors="replace").splitlines()
                        # Capture error/warning lines or tail lines
                        if len(lines) > max_lines_per_log:
                            tail_lines = lines[-max_lines_per_log:]
                        else:
                            tail_lines = lines
                        log_name = os.path.basename(member.name)
                        log_text = "\n".join(tail_lines) if tail_lines else "(Empty log file)"
                        extracted_logs[log_name] = trim_text(log_text, CONFIG.slm_log_chars)
    except Exception as e:
        logger.error(f"Failed to extract log archive: {e}")
    return extracted_logs

async def query_slm(error_event: Dict[str, Any],
                    recent_history: List[Dict[str, Any]],
                    process_logs: Dict[str, str] = None) -> str:
    """Send error event context, 3 process logcat excerpts, and progress history to SLM for analysis."""
    logger.info(
        "Entering query_slm for event=%s errorCode=%s history_events=%d process_logs=%d",
        error_event.get("event", "unknown"),
        error_event.get("errorCode", error_event.get("state", "n/a")),
        len(recent_history),
        len(process_logs or {})
    )
    prompt = build_diagnostic_prompt(error_event, recent_history, process_logs)
    logger.info("Dispatching diagnostic prompt to SLM (%s)...", CONFIG.slm_model)
    
    payload = {
        "model": CONFIG.slm_model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": 0.2,
            "num_ctx": 4096
        }
    }
    logger.info(
        "Prepared SLM payload for model=%s prompt_chars=%d history_events=%d",
        CONFIG.slm_model,
        len(prompt),
        len(recent_history)
    )

    candidate_urls = build_slm_api_candidates(CONFIG.slm_api_url)
    logger.info("SLM endpoint candidates: %s", ", ".join(candidate_urls))
    for candidate_url in candidate_urls:
        probe_tcp_endpoint(candidate_url)

    # Try httpx if available, else urllib
    if "httpx" in sys.modules and httpx is not None:
        for candidate_url in candidate_urls:
            try:
                logger.info("Attempting SLM request via httpx: %s", candidate_url)
                async with httpx.AsyncClient(
                    timeout=httpx.Timeout(connect=5.0, write=15.0, read=CONFIG.slm_timeout_sec, pool=5.0),
                    trust_env=not should_bypass_proxy(candidate_url)
                ) as client:
                    return await post_with_httpx(client, candidate_url, payload)
            except Exception as e:
                logger.warning("httpx request to SLM failed for %s, falling back candidate chain: %s: %r", candidate_url, type(e).__name__, e)

    # Standard urllib fallback
    last_error = None
    for candidate_url in candidate_urls:
        try:
            logger.info("Attempting SLM request via urllib: %s", candidate_url)
            return post_with_urllib(candidate_url, payload)
        except Exception as e:
            last_error = e
            logger.warning("urllib request to SLM failed for %s: %s: %r", candidate_url, type(e).__name__, e)

    return f"[SLM Connection Failed] Could not connect to any SLM endpoint derived from {CONFIG.slm_api_url}: {last_error}. Ensure Ollama or local LLM server is running."


def save_report_file(report_text: str, timestamp: str) -> str:
    """Save the generated SLM diagnostic report to a report file on the Linux server."""
    try:
        os.makedirs(CONFIG.reports_dir, exist_ok=True)
        filename = f"swupdate-report-{timestamp}.md"
        report_path = os.path.join(CONFIG.reports_dir, filename)
        with open(report_path, "w", encoding="utf-8") as f:
            f.write(report_text)
        logger.info(f"Diagnostic report successfully saved to Linux server: {report_path}")
        return report_path
    except Exception as e:
        logger.error(f"Failed to save report file on Linux server: {e}")
        return ""

async def handle_client(reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
    peer = writer.get_extra_info("peername")
    logger.info(f"Client connected from {peer}")
    
    try:
        while True:
            line = await reader.readline()
            if not line:
                logger.info(f"Client {peer} disconnected")
                break
            
            raw_str = line.decode("utf-8", errors="replace").strip()
            if not raw_str:
                continue
            
            try:
                event_data = json.loads(raw_str)
            except json.JSONDecodeError:
                logger.warning(f"Received non-JSON payload: {raw_str}")
                continue

            event_type = event_data.get("event", "unknown")
            session_events.append(event_data)
            
            if event_type == "onUpdateState":
                state_name = event_data.get("stateName", "Unknown")
                est_sec = event_data.get("estimatedUpdateTimeSec", 0)
                logger.info(f"==> [STATE] {state_name} (Est. remaining: {est_sec}s)")
                
                if event_data.get("state") == 6:
                    logger.error("STATE ERROR DETECTED! Triggering initial SLM analysis...")
                    await generate_diagnostic_report(event_data)
                    
            elif event_type == "onUpdateProgress":
                mod = event_data.get("moduleName", "")
                submod = event_data.get("subModuleName", "")
                sub_pct = event_data.get("subModulePercentComplete", 0)
                rel_pct = event_data.get("releasePercentComplete", 0)
                logger.info(f"--> [PROGRESS] Mod: {mod} | Sub: {submod} ({sub_pct}%) | Overall: {rel_pct}%")
                
            elif event_type == "onUpdateError":
                err_code = event_data.get("errorCode", -1)
                err_name = event_data.get("errorName", "Unknown")
                logger.error(f"!!! [ERROR EVENT] Code {err_code}: {err_name}")
                
                logger.info("Triggering initial SLM root-cause analysis on critical error...")
                await generate_diagnostic_report(event_data)
                
            elif event_type == ARCHIVE_EVENT_NAME:
                archive_name = os.path.basename(event_data.get("archiveName", "diagnostics.tar.gz"))
                archive_data_b64 = event_data.get("archiveData", "")
                try:
                    raw_archive_bytes = base64.b64decode(archive_data_b64, validate=True)
                    os.makedirs(CONFIG.diagnostic_dir, exist_ok=True)
                    archive_path = os.path.join(CONFIG.diagnostic_dir, archive_name)
                    with open(archive_path, "wb") as archive_file:
                        archive_file.write(raw_archive_bytes)
                    logger.info(f"Saved SWUpdate diagnostic archive: {archive_path}")

                    process_logs = extract_logs_from_archive(raw_archive_bytes)
                    logger.info(f"Extracted process logs from archive: {list(process_logs.keys())}")

                    last_error_event = find_latest_diagnostic_event(session_events, event_data)

                    logger.info("Triggering SLM root-cause analysis WITH 3 PROCESS LOGS...")
                    await generate_diagnostic_report(
                        last_error_event,
                        process_logs=process_logs,
                        title="         SLM ROOT CAUSE DIAGNOSIS (WITH PROCESS LOGS)",
                        path_label="Report File Created on Linux Server",
                    )

                except (ValueError, OSError) as error:
                    logger.error(f"Could not save or analyze SWUpdate diagnostic archive: {error}")

            elif event_type in ("onCancelUpdResult", "onCompleteUpdResult"):
                res_name = event_data.get("errorName", "Unknown")
                logger.info(f"<-- [{event_type}] Result: {res_name}")
                
    except asyncio.CancelledError:
        pass
    except Exception as e:
        logger.error(f"Exception handling client {peer}: {e}")
    finally:
        writer.close()
        await writer.wait_closed()

async def main():
    logger.info("Starting AI Diagnostic Server on %s:%s", CONFIG.tcp_host, CONFIG.tcp_port)
    logger.info("Connected SLM Endpoint: %s (Model: %s)", CONFIG.slm_api_url, CONFIG.slm_model)
    server = await asyncio.start_server(handle_client, CONFIG.tcp_host, CONFIG.tcp_port, limit=12 * 1024 * 1024)
    async with server:
        await server.serve_forever()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("AI Server shutting down.")
        sys.exit(0)
